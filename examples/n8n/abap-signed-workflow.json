{
  "name": "ABAP signed workflow ingress",
  "id": "abapM3Demo000001",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "abap-workflow",
        "responseMode": "responseNode",
        "options": { "rawBody": true }
      },
      "id": "f01b6a13-4e53-4453-a128-9a65ca019154",
      "webhookId": "abap-m3-workflow-hook",
      "name": "Receive signed ABAP request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst headers = item.json.headers || {};\nconst rawBodyBase64 = item.binary?.data?.data;\nif (typeof rawBodyBase64 !== 'string' || rawBodyBase64.length === 0) throw new Error('Raw ABAP webhook body is unavailable.');\nreturn [{ json: { raw_body_base64: rawBodyBase64, content_type: headers['content-type'] || '', timestamp: headers['x-abap-timestamp'] || '', event_id: headers['x-abap-event-id'] || '', signature: headers['x-abap-signature'] || '' } }];"
      },
      "id": "04e793c8-4c23-46c6-b2ec-f04f2f507c38",
      "name": "Preserve raw signed request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://demo-provider:8090/accept",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify({ 'Content-Type': 'application/json' }) }}",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}",
        "options": { "timeout": 3000 }
      },
      "id": "809e1e19-9f82-40c0-abab-eb17b5c3cc02",
      "name": "Authenticate and durably accept",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [480, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "abapProviderAuth001",
          "name": "ABAP private provider authentication"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: $json.status, event_id: $json.event_id }) }}",
        "options": { "responseCode": 202 }
      },
      "id": "82c0ab31-6bd0-44a5-9f73-d31fb66a0e7e",
      "name": "Acknowledge durable acceptance",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [720, 0]
    }
  ],
  "connections": {
    "Receive signed ABAP request": { "main": [[{ "node": "Preserve raw signed request", "type": "main", "index": 0 }]] },
    "Preserve raw signed request": { "main": [[{ "node": "Authenticate and durably accept", "type": "main", "index": 0 }]] },
    "Authenticate and durably accept": { "main": [[{ "node": "Acknowledge durable acceptance", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveDataErrorExecution": "none", "saveDataSuccessExecution": "none" },
  "versionId": "6ecf69eb-b8f0-45b0-ae82-8a811eb845b1",
  "meta": { "templateCredsSetupCompleted": true },
  "pinData": {}
}
