[Unit]
Description=n8n encrypted off-server production backup
After=docker.service network-online.target abap-backup.service
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=ABAP_OPERATIONS_CONFIG=/etc/abap/operations.conf
LoadCredential=restic_password:/etc/abap/credentials/restic_password
LoadCredential=b2_key_id:/etc/abap/credentials/b2_key_id
LoadCredential=b2_application_key:/etc/abap/credentials/b2_application_key
LoadCredential=heartbeat_n8n_backup_url:/etc/abap/credentials/heartbeat_n8n_backup_url
CacheDirectory=abap-restic
CacheDirectoryMode=0700
ExecStart=/usr/local/sbin/n8n-backup
ExecStopPost=/usr/local/sbin/n8n-ensure-running
CPUQuota=25%
MemoryMax=384M
TasksMax=64
KillMode=mixed
TimeoutStartSec=30min
TimeoutStopSec=90s
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/n8n /var/cache/abap-restic /run/lock /var/run/docker.sock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
