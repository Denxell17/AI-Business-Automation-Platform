# Application database backend.
# Use sqlite for normal local development and automated unit tests.
# Use postgresql for PostgreSQL integration or production.
DATABASE_BACKEND=sqlite

# Required when DATABASE_BACKEND=postgresql.
# Keep the application URL consistent with the PostgreSQL values below.
DATABASE_URL=postgresql://abap_user:replace_with_a_secure_password@127.0.0.1:5432/abap?connect_timeout=5

# Local Docker PostgreSQL configuration used by compose.yaml.
POSTGRES_DB=abap
POSTGRES_USER=abap_user
POSTGRES_PASSWORD=replace_with_a_secure_password
