# Application database backend.
# Use sqlite for normal local development and automated unit tests.
# Use postgresql for PostgreSQL integration or production.
DATABASE_BACKEND=sqlite

# Required when DATABASE_BACKEND=postgresql.
# Keep the application URL consistent with the PostgreSQL values below.
DATABASE_URL=postgresql://abap_user:replace_with_a_secure_password@127.0.0.1:5432/abap?connect_timeout=5

# Local Docker PostgreSQL configuration used by compose.yaml.
POSTGRES_DB=abap
POSTGRES_USER=abap_user
POSTGRES_PASSWORD=replace_with_a_secure_password

# Required only when ABAP constructs the OpenAI agent provider.
# Store the real secret in a local .env file or deployment secret manager.
OPENAI_API_KEY=replace_with_an_openai_api_key

# One OpenAI request may run for 1 through 120 seconds.
OPENAI_TIMEOUT_SECONDS=30


# Required when using the one-off AI Assistant.
# Choose a model supported by the configured provider and account.
AI_ASSISTANT_MODEL=replace_with_a_supported_model

# Deployment only: generate with secrets.token_urlsafe(48); keep stable across restarts.
# compose.deploy.yaml requires DATABASE_BACKEND=postgresql and a DATABASE_URL
# whose host is database, not 127.0.0.1. See README deployment instructions.
ABAP_SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
ABAP_IMAGE_TAG=day154

# Runtime environment label. Accepted contract values are local,
# integration-test, staging, and production.
ABAP_ENVIRONMENT=local

# Milestone 1 scheduler worker. Keep disabled in the web process and set to
# true only for the dedicated worker service after database migrations finish.
ABAP_WORKER_ENABLED=false
ABAP_WORKER_POLL_SECONDS=5
ABAP_WORKER_CLAIM_LIMIT=25
ABAP_WORKER_LEASE_SECONDS=120
ABAP_WORKER_MAX_ATTEMPTS=5
ABAP_WORKER_RETRY_BASE_SECONDS=5
ABAP_WORKER_RETRY_MAX_SECONDS=300
ABAP_WORKER_STALE_AFTER_SECONDS=900
ABAP_WORKER_SHUTDOWN_GRACE_SECONDS=30

# Milestone 2 configuration example: use an explicitly allowlisted HTTPS
# origin. The private n8n network transport needs its own Milestone 3 design.
# No webhook is sent by these settings alone.
ABAP_N8N_BASE_URL=https://automation.example.test
ABAP_N8N_WORKFLOW_PATH=/webhook/replace_with_workflow_path
ABAP_INTEGRATION_ALLOWED_HOSTS=automation.example.test
ABAP_N8N_PRIVATE_DEVELOPMENT_NETWORK=false
ABAP_WEBHOOK_CONNECT_TIMEOUT_SECONDS=3
ABAP_WEBHOOK_READ_TIMEOUT_SECONDS=15
ABAP_WEBHOOK_MAX_REQUEST_BYTES=262144
ABAP_WEBHOOK_MAX_RESPONSE_BYTES=262144
ABAP_WEBHOOK_SIGNATURE_TTL_SECONDS=300
ABAP_WEBHOOK_MAX_ATTEMPTS=3

# Durable outbound retry worker controls. The worker leases a due delivery
# before sending, so a restart waits for the short lease before retrying.
ABAP_WEBHOOK_RETRY_POLL_SECONDS=10
ABAP_WEBHOOK_RETRY_LEASE_SECONDS=30
ABAP_WEBHOOK_RETRY_CLAIM_LIMIT=25
ABAP_WEBHOOK_MAINTENANCE_INTERVAL_SECONDS=3600
ABAP_WEBHOOK_DELIVERY_RETENTION_DAYS=90

# Secrets must be different values and must come from an untracked .env file
# locally or the deployment secret manager in staging/production.
ABAP_OUTBOUND_WEBHOOK_SECRET=replace_with_a_random_outbound_secret
ABAP_INBOUND_WEBHOOK_SECRET=replace_with_a_different_random_inbound_secret
# Absolute host path to a mode-0400/0440 file containing a scoped random provider token.
ABAP_N8N_PROVIDER_TOKEN_FILE=/absolute/path/to/abap-n8n-provider-token
ABAP_N8N_CALLBACK_MAX_ATTEMPTS=3
ABAP_N8N_CALLBACK_TIMEOUT_SECONDS=3
ABAP_N8N_CALLBACK_RETRY_WAIT_SECONDS=1

# Milestone 3 isolated n8n Compose demo only. The demo overlay sets the fixed
# private address http://n8n:5678 and never publishes an n8n port. Generate an
# unrelated local value; never use a production n8n encryption key here.
ABAP_N8N_ENCRYPTION_KEY=replace_with_an_isolated_n8n_encryption_key

# Milestone 6 provider contract. Leave disabled until an adapter and its tests
# exist; provider-specific credentials belong only in the secret manager.
ABAP_INTEGRATIONS_ENABLED=false
ABAP_EXTERNAL_PROVIDER=disabled
# Advanced authenticated assistant (disabled; independent of the public RAG chatbot).
ABAP_ADVANCED_ASSISTANT_ENABLED=false
# Set true only after verifying provider billing, quota and data-processing policies.
ABAP_ASSISTANT_REMOTE_APPROVED=false
# Explicit comma-separated model IDs; no automatic fallback or paid OpenRouter IDs.
ABAP_ASSISTANT_GEMINI_MODELS=
ABAP_ASSISTANT_GEMINI_KEY=
ABAP_ASSISTANT_GEMINI_KEY_FILE=
ABAP_ASSISTANT_OPENROUTER_MODELS=
ABAP_ASSISTANT_OPENROUTER_KEY=
ABAP_ASSISTANT_OPENROUTER_KEY_FILE=
# Optional operator-managed HTTPS chat-completions endpoint.
ABAP_ASSISTANT_COMPATIBLE_MODELS=
ABAP_ASSISTANT_COMPATIBLE_URL=
ABAP_ASSISTANT_COMPATIBLE_KEY=
ABAP_ASSISTANT_COMPATIBLE_KEY_FILE=
ABAP_ASSISTANT_N8N_WORKFLOWS=

# Cloud-only production assistant. Evidence must be refreshed after credential rotation and within 24h.
ABAP_ASSISTANT_ALLOW_LOCAL_DEVELOPMENT=false
ABAP_ASSISTANT_CLOUD_VALIDATION_FILE=
ABAP_ASSISTANT_GEMINI_FREE_ACCOUNT_REVIEWED=false
ABAP_ASSISTANT_GEMINI_FREE_MODELS=
ABAP_ASSISTANT_COMPATIBLE_FREE_ACCOUNT_REVIEWED=false
ABAP_ASSISTANT_COMPATIBLE_FREE_MODELS=
ABAP_ASSISTANT_USER_DAILY_LIMIT=100
ABAP_ASSISTANT_USER_MODEL_DAILY_LIMIT=20
ABAP_ASSISTANT_MODEL_DAILY_LIMIT=40
ABAP_ASSISTANT_PROVIDER_DAILY_LIMIT=40
ABAP_ASSISTANT_GLOBAL_DAILY_LIMIT=1000
ABAP_ASSISTANT_USER_PER_MINUTE=10
ABAP_ASSISTANT_MODEL_PER_MINUTE=20
ABAP_ASSISTANT_PROVIDER_PER_MINUTE=20
ABAP_ASSISTANT_GLOBAL_PER_MINUTE=60
ABAP_ASSISTANT_USER_CONCURRENCY=1
ABAP_ASSISTANT_MODEL_CONCURRENCY=2
ABAP_ASSISTANT_PROVIDER_CONCURRENCY=2
ABAP_ASSISTANT_GLOBAL_CONCURRENCY=4

# Initial advanced-assistant release: fixed synthetic/public prompts and isolated demo records only.
ABAP_ASSISTANT_DEMO_ONLY=true
